{
  "name": "subsequent-solstice",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "emdash": {
    "seed": "seed/legacy-docs.json"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "seed:legacy": "node scripts/generate-emdash-seed.mjs",
    "build": "npm run seed:legacy && astro check && astro build",
    "build:authoring": "npm run seed:legacy && astro check && EMDASH_LOCAL_AUTHORING=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf:dev": "npm run build && wrangler dev",
    "cf:dev:authoring": "npm run build:authoring && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/markdown-satteri": "0.4.0",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/partytown": "2.1.8",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.4",
    "@bruits/satteri-wasm32-wasi": "0.10.5",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@fontsource/ibm-plex-sans-thai": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "astro": "7.3.2",
    "emdash": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.143.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "mdast-util-to-hast": "^13.2.1",
    "picomatch": "^2.3.2",
    "yaml": "^2.9.1"
  }
}
